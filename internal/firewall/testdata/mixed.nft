#!/usr/sbin/nft -f
# Generated by Tunnelward. Do not edit, changes will be overwritten.

# Create the table if missing, then delete it, so the definition below
# replaces it completely. nft applies the whole file in one transaction.
table inet tunnelward
delete table inet tunnelward

table inet tunnelward {
	set nonpublic {
		type ipv4_addr
		flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 }
	}

	chain forward {
		type filter hook forward priority filter; policy accept;
		iifname != "wg0" oifname != "wg0" return
		ct state invalid drop
		# Replies skip the rules. Everything a device sends is checked, also on open connections.
		ct state established,related ct direction reply accept
		# Anything else from outside the tunnel to devices.
		iifname != "wg0" drop
		meta nfproto ipv6 drop
		ip saddr vmap {
			10.8.0.3 : jump fwd_dev_2,
			10.8.0.4 : jump fwd_dev_3,
			10.8.0.5 : jump fwd_dev_4
		}
		drop
	}

	chain input {
		type filter hook input priority filter; policy accept;
		iifname != "wg0" return
		ct state invalid drop
		# Replies skip the rules. Everything a device sends is checked, also on open connections.
		ct state established,related ct direction reply accept
		meta nfproto ipv6 drop
		ip saddr vmap {
			10.8.0.3 : jump in_dev_2,
			10.8.0.4 : jump in_dev_3,
			10.8.0.5 : jump in_dev_4
		}
		drop
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr 10.8.0.0/24 oifname != "wg0" masquerade
	}

	# Device 2 "Grandma's tablet" (10.8.0.3), traffic through the server
	chain fwd_dev_2 {
		# profile "Internet only"; profile "Streaming"
		ip daddr != @nonpublic accept
		# profile "Home DNS"
		ip daddr 192.168.1.2 meta l4proto { tcp, udp } th dport 53 accept
		# custom: Jellyfin
		ip daddr 192.168.1.10 tcp dport 8096 accept
		# custom
		ip daddr 192.168.1.20 udp dport 5000-5010 accept
	}

	# Device 2 "Grandma's tablet" (10.8.0.3), traffic to the server itself
	chain in_dev_2 {
		# profile "Home DNS"
		ip daddr 192.168.1.2 meta l4proto { tcp, udp } th dport 53 accept
		# custom: Jellyfin
		ip daddr 192.168.1.10 tcp dport 8096 accept
		# custom
		ip daddr 192.168.1.20 udp dport 5000-5010 accept
	}

	# Device 3 "Laptop" (10.8.0.4), traffic through the server
	chain fwd_dev_3 {
		# profile "Internet only"
		ip daddr != @nonpublic accept
		# custom: ping the server
		ip daddr 10.8.0.1 meta l4proto icmp accept
		# profile "LAN"
		ip daddr 192.168.1.0/24 accept
	}

	# Device 3 "Laptop" (10.8.0.4), traffic to the server itself
	chain in_dev_3 {
		# custom: ping the server
		ip daddr 10.8.0.1 meta l4proto icmp accept
		# profile "LAN"
		ip daddr 192.168.1.0/24 accept
	}

	# Device 4 "Locked out\nnewline" (10.8.0.5), traffic through the server
	chain fwd_dev_4 {
		# No rules: everything is dropped.
	}

	# Device 4 "Locked out\nnewline" (10.8.0.5), traffic to the server itself
	chain in_dev_4 {
		# No rules: everything is dropped.
	}
}
