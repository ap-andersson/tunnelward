#!/usr/sbin/nft -f
# Generated by Tunnelward. Do not edit, changes will be overwritten.

# Create the table if missing, then delete it, so the definition below
# replaces it completely. nft applies the whole file in one transaction.
table inet tunnelward
delete table inet tunnelward

table inet tunnelward {
	set nonpublic {
		type ipv4_addr
		flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 224.0.0.0/4, 240.0.0.0/4 }
	}

	chain forward {
		type filter hook forward priority filter; policy accept;
		iifname != "wg1" oifname != "wg1" return
		ct state established,related accept
		ct state invalid drop
		# New connections from outside the tunnel to devices.
		iifname != "wg1" drop
		meta nfproto ipv6 drop
		ip saddr vmap {
			198.51.100.2 : jump fwd_dev_1
		}
		drop
	}

	chain input {
		type filter hook input priority filter; policy accept;
		iifname != "wg1" return
		ct state established,related accept
		ct state invalid drop
		meta nfproto ipv6 drop
		ip saddr vmap {
			198.51.100.2 : jump in_dev_1
		}
		drop
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr 198.51.100.0/24 oifname != "wg1" masquerade
	}

	# Device 1 "x" (198.51.100.2), traffic through the server
	chain fwd_dev_1 {
		# profile "Internet only"
		ip daddr != @nonpublic accept
	}

	# Device 1 "x" (198.51.100.2), traffic to the server itself
	chain in_dev_1 {
		# No rules: everything is dropped.
	}
}
