#!/usr/sbin/nft -f
# Generated by Tunnelward. Do not edit, changes will be overwritten.

# Create the table if missing, then delete it, so the definition below
# replaces it completely. nft applies the whole file in one transaction.
table inet tunnelward
delete table inet tunnelward

table inet tunnelward {
	set nonpublic {
		type ipv4_addr
		flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 }
	}

	chain forward {
		type filter hook forward priority filter; policy accept;
		iifname != "wg0" oifname != "wg0" return
		ct state invalid drop
		# Replies skip the rules. Everything a device sends is checked, also on open connections.
		ct state established,related ct direction reply accept
		# Anything else from outside the tunnel to devices.
		iifname != "wg0" drop
		meta nfproto ipv6 drop
		drop
	}

	chain input {
		type filter hook input priority filter; policy accept;
		iifname != "wg0" return
		ct state invalid drop
		# Replies skip the rules. Everything a device sends is checked, also on open connections.
		ct state established,related ct direction reply accept
		meta nfproto ipv6 drop
		drop
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr 10.8.0.0/24 oifname != "wg0" masquerade
	}
}
